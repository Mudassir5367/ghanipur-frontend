# LOCAL DEV template. Copy to .env and edit. NEVER commit the real .env.
# For the EC2 / Docker Compose deployment use .env.production.example instead.

# Browser API base — relative for the same-origin proxy (recommended), or an absolute URL.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where the Next server proxies /api/v1 and /uploads, and does SSR fetches.
# API_PROXY_TARGET is read when the config is evaluated (build/start);
# INTERNAL_API_URL is read at runtime. In Docker both come from BACKEND_ORIGIN.
API_PROXY_TARGET=http://localhost:5000
INTERNAL_API_URL=http://localhost:5000/api/v1
