# PRODUCTION template for ghanipur.pk. Only needed when running the frontend
# standalone (npm start). In the Docker combined stack these values come from the
# backend .env.production (build args + INTERNAL_API_URL). Copy to .env.production.

# Same-origin: the browser calls the Next server, which proxies /api/v1 to the backend.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=https://ghanipur.pk

# Where the Next server proxies /api/v1 and /uploads (SSR/runtime).
# In Docker use the backend service name; standalone use the backend's real URL.
API_PROXY_TARGET=http://backend:5000
INTERNAL_API_URL=http://backend:5000/api/v1
