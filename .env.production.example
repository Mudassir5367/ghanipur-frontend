# PRODUCTION template for the Docker Compose deployment (EC2).
#   cp .env.production.example .env    # then edit, and `docker compose up -d --build`
# Compose reads `.env` from this directory. NEVER commit the real .env.

# ---- Domain -----------------------------------------------------------------
# The hostname Caddy serves and obtains a Let's Encrypt certificate for; www is
# redirected to it. Its A record (and www's) must point at this machine, with
# inbound 80 and 443 open, before the first `up`.
SITE_DOMAIN=ghanipur.pk

# ---- Public URL of this frontend -------------------------------------------
# The origin users hit in the browser — https://SITE_DOMAIN. Baked into the
# build (SEO metadata, sitemap, robots.txt), so changing it needs a rebuild, not
# just a restart.
NEXT_PUBLIC_APP_URL=https://ghanipur.pk

# ---- Browser -> API ---------------------------------------------------------
# Keep this RELATIVE. The browser calls this Next server, which proxies to the
# backend, so the refresh cookie stays first-party and no CORS setup is needed.
NEXT_PUBLIC_API_URL=/api/v1

# ---- Next server -> backend (server-side only) ------------------------------
# The backend runs on its OWN machine, so this is an address, not a Docker
# service name. Never used by the browser — only by this container.
#
# Prefer the backend's PRIVATE IP when both instances sit in the same VPC:
# traffic then stays inside AWS instead of crossing the public internet in
# plaintext, and costs nothing. Fall back to the public IP only if they are in
# different VPCs, and lock the backend's security group to this machine.
#
#   same VPC:      http://<backend-private-ip>:5000
#   different VPC: http://<backend-public-ip>:5000
#
# Baked into the image (Next evaluates rewrites() at build), so a change here
# requires `docker compose up -d --build`.
BACKEND_ORIGIN=http://<backend-private-ip>:5000
