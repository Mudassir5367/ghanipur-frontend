# PRODUCTION template for the Docker Compose deployment (EC2).
#   cp .env.production.example .env    # then edit, and `docker compose up -d --build`
# Compose reads `.env` from this directory. NEVER commit the real .env.

# ---- Public URL of this frontend -------------------------------------------
# The origin users hit in the browser. Baked into the build (SEO metadata,
# sitemap, robots.txt), so a change here needs a rebuild, not just a restart.
# EC2 without a domain:  http://<ec2-public-ip>:3000
# With a domain:         https://ghanipur.pk
NEXT_PUBLIC_APP_URL=http://<ec2-public-ip>:3000

# ---- Browser -> API ---------------------------------------------------------
# Keep this RELATIVE. The browser calls this Next server, which proxies to the
# backend, so the refresh cookie stays first-party (no CORS config needed).
NEXT_PUBLIC_API_URL=/api/v1

# ---- Next server -> backend (server-side only) ------------------------------
# Resolved over the shared `ghanipur-net` Docker network, so `backend` is the
# backend compose service name. These hosts are never used by the browser.
# API_PROXY_TARGET is baked at build time; INTERNAL_API_URL is read at runtime.
API_PROXY_TARGET=http://backend:5000
INTERNAL_API_URL=http://backend:5000/api/v1

# ---- Host port --------------------------------------------------------------
# Host port published for the container's 3000. Set to 80 if you want to serve
# the site without a port in the URL (also update NEXT_PUBLIC_APP_URL).
FRONTEND_PORT=3000
